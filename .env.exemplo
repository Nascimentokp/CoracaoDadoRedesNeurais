# Copie para .env e preencha. O .env não vai para o git.
# Sem nenhuma chave, o assistente funciona em modo demonstração (sem IA, sem custo).

# OpenAI
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ou DeepSeek (mesmo protocolo da OpenAI, outro endereço)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# Opcional: força um provedor (openai, deepseek ou demo)
# LLM_PROVEDOR=demo
